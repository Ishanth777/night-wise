{
  "version": 8,
  "name": "NightWise Quiet Map",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 19
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ECECE6" }
    },
    {
      "id": "osm",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-saturation": -1,
        "raster-contrast": -0.06,
        "raster-brightness-min": 0.24,
        "raster-brightness-max": 0.9,
        "raster-opacity": 0.94
      }
    }
  ]
}