# ---- NightWise backend environment ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL + PostGIS (docker-compose default)
DATABASE_URL=postgres://nightwise:nightwise@localhost:5432/nightwise

# Redis
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=dev_only_change_me_0
JWT_REFRESH_SECRET=dev_only_change_me_1

# Valhalla routing engine
VALHALLA_URL=http://localhost:8002
# Photon geocoder (optional; falls back to Nominatim URL below if unset)
PHOTON_URL=http://localhost:2322
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_APP_NAME=nightwise-dev

# Service area (plan §11.2): Bengaluru bbox
SERVICE_BBOX_W=77.30
SERVICE_BBOX_E=77.90
SERVICE_BBOX_S=12.70
SERVICE_BBOX_N=13.25

# Google Places augmentation (OPTIONAL — feature degrades to OSM hours + priors if unset)
# Place hours are a plan §6.2 augmentation; without a key the app still works honestly.
GOOGLE_PLACES_API_KEY=
PLACES_MONTHLY_BUDGET_CAP_USD=20
PLACES_ENABLED=false

# Rate limiting
RATE_LIMIT_GLOBAL_PER_HOUR=240
RATE_LIMIT_RECOMMEND_PER_HOUR_USER=120
RATE_LIMIT_RECOMMEND_PER_HOUR_IP=30
RATE_LIMIT_REPORTS_PER_DAY_USER=5

# Data: path to the clipped Bengaluru extract used by the ingest job
OSM_PBF_PATH=../data/bengaluru-latest.osm.pbf
