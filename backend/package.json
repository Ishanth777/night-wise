{
  "name": "nightwise-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:scoring": "vitest run src/scoring",
    "test:integration": "RUN_INTEGRATION=1 vitest run src/__tests__/integration",
    "migrate": "node-pg-migrate -m src/db/migrations up",
    "migrate:down": "node-pg-migrate -m src/db/migrations down",
    "seed:data-sources": "tsx src/db/seeds/dataSources.seed.ts",
    "ingest:osm": "tsx src/jobs/osm-ingest.job.ts",
    "openapi": "tsx src/api/schemas/generate-openapi.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "opossum": "^8.3.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pg-boss": "^10.2.0",
    "rate-limiter-flexible": "^5.0.5",
    "simple-opening-hours": "^0.1.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1",
    "@sentry/node": "^8.50.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "node-pg-migrate": "^7.8.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
